# Database PostgreSQL locale
DB_URL=jdbc:postgresql://localhost:5432/ls-manager
DB_USERNAME=postgres
DB_PASSWORD=
DB_MAX_POOL_SIZE=5

# Generare un valore casuale lungo almeno 64 byte; non usare questo commento come segreto.
JWT_SECRET=

# Usate solo dal bootstrap manuale AdminUserBootstrap.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=vivaadmin123

SERVER_PORT=8084
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8084

# In locale HTTP deve essere false; in produzione HTTPS deve essere true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=
ACCESS_COOKIE_MAX_AGE=15m
REFRESH_COOKIE_MAX_AGE=7d

JPA_SHOW_SQL=false
LOG_LEVEL=info
